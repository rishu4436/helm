{
  "name": "@helm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "prisma migrate dev --schema ../../prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema ../../prisma/schema.prisma",
    "db:generate": "prisma generate --schema ../../prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@helm/connectors": "workspace:*",
    "@helm/security": "workspace:*",
    "@helm/shared": "workspace:*",
    "@helm/trading-core": "workspace:*",
    "@prisma/client": "^6.19.0",
    "fastify": "^5.2.0",
    "zod": "^3.24.0",
    "@helm/portfolio": "workspace:*",
    "@helm/risk-engine": "workspace:*",
    "@helm/voice-engine": "workspace:*",
    "@helm/pulse": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "tsx": "^4.19.0"
  }
}