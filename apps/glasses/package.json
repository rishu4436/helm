{
  "name": "@helm/glasses",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HELM G2 plugin (Even Hub). Started from even-realities/evenhub-templates/minimal.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "pack": "pnpm build && evenhub pack app.json dist -o helm.ehpk",
    "simulate": "evenhub-simulator http://localhost:5173"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@evenrealities/pretext": "latest",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
