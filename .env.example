# Copy to .env (never commit .env). All provider credentials must be DEMO / PAPER keys only.
DATABASE_URL=postgresql://helm@127.0.0.1:5444/helm_dev
HELM_CREDENTIAL_KEY= # 32-byte base64 key for AES-256-GCM credential encryption: openssl rand -base64 32
HELM_LIVE_TRADING=false # hard-blocked; any value other than false is rejected at startup
API_PORT=4000

# Speech-to-text. local = faster-whisper sidecar on 127.0.0.1 (services/stt, no paid key; `pnpm stt:setup && pnpm stt:serve`).
# deterministic = TEST STT (scripted, labelled). With local, the TEST STT is the labelled FALLBACK unless HELM_STT_FALLBACK=none.
HELM_STT_PROVIDER=local
HELM_STT_LOCAL_URL=http://127.0.0.1:8178
# HELM_STT_FALLBACK=none

# Per-IP requests/minute (default 120). Raise locally for Playwright runs.
# HELM_RATE_LIMIT_MAX=900

# Required in production (Render): session token pepper (openssl rand -base64 32). Optional locally.
# HELM_SESSION_SECRET=

# Comma-separated companion origins allowed by CORS, in addition to localhost.
# HELM_CORS_ORIGINS=https://helm.vercel.app

# Render sets PORT. Bind 0.0.0.0 in production (see apps/api/src/server.ts).
# HOST=0.0.0.0
# PORT=4000
