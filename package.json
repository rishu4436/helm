{
  "name": "helm",
  "private": true,
  "version": "0.1.0",
  "description": "HELM — Universal Trading Command Center for Even Realities G2",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "dev:api": "pnpm --filter @helm/api dev",
    "dev:glasses": "pnpm --filter @helm/glasses dev",
    "dev:companion": "pnpm --filter @helm/companion dev",
    "check:live-public": "tsx scripts/live-public-check.ts",
    "stt:setup": "bash services/stt/setup.sh",
    "stt:serve": "${HELM_STT_VENV:-/workspace/helm-stt/venv}/bin/python services/stt/server.py",
    "stt:fixtures": "/workspace/tts/venv/bin/python services/stt/make_fixtures.py tests/fixtures/voice",
    "check:stt": "tsx scripts/live-stt-demo.ts"
  },
  "devDependencies": {
    "@helm/connectors": "workspace:*",
    "@helm/portfolio": "workspace:*",
    "@helm/pulse": "workspace:*",
    "@helm/risk-engine": "workspace:*",
    "@helm/security": "workspace:*",
    "@helm/shared": "workspace:*",
    "@helm/trading-core": "workspace:*",
    "@helm/voice-engine": "workspace:*",
    "@playwright/test": "1.65.1",
    "@prisma/client": "6.19.3",
    "@types/node": "^22.10.0",
    "dotenv": "^18.0.10",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "type": "module"
}
